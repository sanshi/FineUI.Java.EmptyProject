<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 spring-boot-starter-parent 拿依赖版本管理。应用工程直接跑在 FineUI.Java 支持区间的
         上沿（Boot 4.1.x）；tomcat.version 覆盖托管值 11.0.24，消掉 CVE-2026-65182 等已知漏洞。 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.fineui</groupId>
    <artifactId>fineui-java-emptyproject</artifactId>
    <version>16.0.0-rc.1</version>
    <name>FineUI.Java EmptyProject</name>
    <description>FineUI.Java 空项目：包含最少功能（开始 / 首页框架 / 登录 / 主题）的骨架工程，便于熟悉用法与重现问题。</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <fineui.version>16.0.0-rc.1</fineui.version>
        <!-- 覆盖 Boot 4.1.1 托管的 Tomcat 11.0.24：消掉 CVE-2026-65182 等已知漏洞（同 minor patch 级替换） -->
        <tomcat.version>11.0.26</tomcat.version>
    </properties>

    <dependencies>
        <!-- FineUI.Java 库（社区版）：方言 / 回发端点 / 页面路由扫描 / 内嵌 F.js 运行时全自动装配，业务侧零 @Configuration。
             正常联网时由 Maven Central 自动解析；内网离线使用时，先安装官方同版本本地包。 -->
        <dependency>
            <groupId>com.fineui</groupId>
            <artifactId>fineui-java</artifactId>
            <version>${fineui.version}</version>
        </dependency>

        <!-- 表单校验：fineui-java 里是 optional 不传递，独立项目须显式加，否则 getModelState().isValid() 走不通校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 开发期辅助（可选）：改模板刷新即生效；改 Java 后应重启应用，不依赖自动重启 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
